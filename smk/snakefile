from pathlib import Path
import tempfile

import geopandas as gpd
import pandas as pd
from snakemake.logging import logger


SNAKEFILE_DIR = Path(workflow.basedir)
configfile: str(SNAKEFILE_DIR / "config.yaml")


def _parse_id_values(value):
    if value is None:
        return []
    if isinstance(value, str):
        return [v.strip() for v in value.split(",") if v.strip()]
    value_l = []
    for item in value:
        value_l.extend(_parse_id_values(item))
    return value_l


INDEX_FP = Path(config["index_fp"])
OUT_DIR = Path(config["out_dir"])
TMPDIR = Path(tempfile.gettempdir())
CHIP_ID_L = _parse_id_values(config.get("chip_ids", []))
EVENT_ID_L = _parse_id_values(config.get("event_ids", []))
logger.info(f"loading chip index from {INDEX_FP}")
logger.info(f"writing outputs under {OUT_DIR}")
logger.info(f"using system tmpdir {TMPDIR}")
if EVENT_ID_L:
    logger.info(f"event_ids filter: {','.join(EVENT_ID_L)}")
if CHIP_ID_L:
    logger.info(f"chip_ids filter: {','.join(CHIP_ID_L)}")

index_gdf = gpd.read_file(INDEX_FP)[["Event", "Chip_ID"]].drop_duplicates().copy()
if EVENT_ID_L:
    index_gdf = index_gdf.loc[index_gdf["Event"].isin(EVENT_ID_L)].copy()
if CHIP_ID_L:
    index_gdf = index_gdf.loc[index_gdf["Chip_ID"].isin(CHIP_ID_L)].copy()
assert not index_gdf.empty, "No chips selected from the snakemake config"
logger.info(f"selected {len(index_gdf):,} chip(s) for this run")

target_d = index_gdf.sort_values(["Event", "Chip_ID"]).to_dict("list")
search_manifest_fp_l = expand(
    str(OUT_DIR / "{event}" / "{chip_id}" / "chip_search_manifest.json"),
    zip,
    event=target_d["Event"],
    chip_id=target_d["Chip_ID"],
)
search_summary_fp_l = expand(
    str(OUT_DIR / "{event}" / "{chip_id}" / "chip_search_summary.tsv"),
    zip,
    event=target_d["Event"],
    chip_id=target_d["Chip_ID"],
)
match_diagnostics_fp_l = expand(
    str(OUT_DIR / "{event}" / "{chip_id}" / "match_diagnostics.json"),
    zip,
    event=target_d["Event"],
    chip_id=target_d["Chip_ID"],
)
summary_fp_l = expand(
    str(OUT_DIR / "{event}" / "{chip_id}" / "summary.csv"),
    zip,
    event=target_d["Event"],
    chip_id=target_d["Chip_ID"],
)
concat_summary_fp = str(OUT_DIR / "summary_all.csv")
match_plot_fp_l = expand(
    str(OUT_DIR / "{event}" / "{chip_id}" / "match_plot.png"),
    zip,
    event=target_d["Event"],
    chip_id=target_d["Chip_ID"],
)
match_report_fp = str(OUT_DIR / "match_report.md")


rule all:
    input:
        summary=concat_summary_fp,
        diagnostics=match_diagnostics_fp_l,
        match_report=match_report_fp
    default_target: True


rule _1_fetch_ps_chip_manifest_all:
    input:
        search_manifest_fp_l,
        search_summary_fp_l


rule _1_fetch_ps_chip_manifest:
    output:
        search_manifest_fp=str(OUT_DIR / "{event}" / "{chip_id}" / "chip_search_manifest.json"),
        search_summary_fp=str(OUT_DIR / "{event}" / "{chip_id}" / "chip_search_summary.tsv")
    log:
        str(OUT_DIR / "{event}" / "{chip_id}" / "_1_fetch_ps_chip_manifest.log")
    params:
        index_fp=str(INDEX_FP),
        out_dir=str(OUT_DIR),
        tmpdir=str(TMPDIR),
        search_limit=int(config["search_limit"]),
        lower_window_hours=int(config["lower_window_hours"]),
        upper_window_hours=int(config["upper_window_hours"]),
        poll_delay_seconds=int(config["poll_delay_seconds"]),
        poll_max_attempts=int(config["poll_max_attempts"]),
        logging_level="DEBUG"
    script:
        "scripts/_1_fetch_ps_chip_manifest.py"


rule _2_fetch_match_all:
    input:
        summary_fp_l,
        match_diagnostics_fp_l


rule _2_fetch_match:
    input:
        search_manifest_fp=str(OUT_DIR / "{event}" / "{chip_id}" / "chip_search_manifest.json")
    output:
        summary_fp=str(OUT_DIR / "{event}" / "{chip_id}" / "summary.csv"),
        match_diagnostics_fp=str(OUT_DIR / "{event}" / "{chip_id}" / "match_diagnostics.json")
    log:
        str(OUT_DIR / "{event}" / "{chip_id}" / "_2_fetch_match.log")
    params:
        index_fp=str(INDEX_FP),
        out_dir=str(OUT_DIR),
        tmpdir=str(TMPDIR),
        floodplanet_root=str(config["floodplanet_root"]),
        chip_search_max=int(config["chip_search_max"]),
        candidate_min_coverage_ratio=float(config["candidate_min_coverage_ratio"]),
        search_limit=int(config["search_limit"]),
        lower_window_hours=int(config["lower_window_hours"]),
        upper_window_hours=int(config["upper_window_hours"]),
        poll_delay_seconds=int(config["poll_delay_seconds"]),
        poll_max_attempts=int(config["poll_max_attempts"]),
        compare_percentile_low=float(config["compare_percentile_low"]),
        compare_percentile_high=float(config["compare_percentile_high"]),
        compare_quadrants=int(config["compare_quadrants"]),
        compare_min_valid_fraction=float(config["compare_min_valid_fraction"]),
        match_mean_quad_corr_min=float(config["match_mean_quad_corr_min"]),
        match_min_quad_corr_min=float(config["match_min_quad_corr_min"]),
        match_mean_quad_ssim_min=float(config["match_mean_quad_ssim_min"]),
        match_mean_mae_max=float(config["match_mean_mae_max"]),
        compare_resampling=str(config["compare_resampling"]),
        write_compare_debug=bool(config["write_compare_debug"]),
        logging_level="DEBUG"
    script:
        "scripts/_2_fetch_match.py"


rule _3_concat_chip_summaries:
    input:
        summary_fp_l
    output:
        concat_summary_fp
    log:
        str(OUT_DIR / "summary_all.log")
    run:
        summary_df = pd.concat([pd.read_csv(fp) for fp in input], ignore_index=True)
        summary_df.to_csv(output[0], index=False)

        event_count_s = summary_df.groupby("event").size().sort_values(ascending=False)
        matched_count_s = summary_df.groupby("event")["matched"].sum(min_count=1).sort_values(ascending=False)
        attempted_count_s = summary_df.groupby("event")["attempted_candidates"].sum(min_count=1).sort_values(ascending=False)

        with open(log[0], "w") as f:
            f.write(f"wrote combined summary to {output[0]}\n")
            f.write(f"rows={len(summary_df):,}\n")
            f.write("event_row_counts:\n")
            f.write(event_count_s.to_string())
            f.write("\n\nevent_matched_counts:\n")
            f.write(matched_count_s.to_string())
            f.write("\n\nevent_attempted_counts:\n")
            f.write(attempted_count_s.to_string())
            f.write("\n")

        logger.info(f"wrote combined summary to {output[0]}")
        logger.info(f"event row counts:\n{event_count_s.to_string()}")
        logger.info(f"event matched counts:\n{matched_count_s.to_string()}")
        logger.info(f"event attempted counts:\n{attempted_count_s.to_string()}")


rule _3_concat_chip_summaries_all:
    input:
        concat_summary_fp


rule _4_plot_match_chip:
    input:
        match_diagnostics_fp=str(OUT_DIR / "{event}" / "{chip_id}" / "match_diagnostics.json")
    output:
        plot_fp=str(OUT_DIR / "{event}" / "{chip_id}" / "match_plot.png")
    log:
        str(OUT_DIR / "{event}" / "{chip_id}" / "_4_plot_match_chip.log")
    params:
        floodplanet_root=str(config["floodplanet_root"]),
        logging_level="DEBUG"
    script:
        "scripts/_4_plot_match_chip.py"


rule _4_plot_match_chips_all:
    input:
        match_plot_fp_l


rule _4_match_report:
    input:
        plot_fp_l=match_plot_fp_l,
        summary_fp_l=summary_fp_l
    output:
        report_fp=match_report_fp
    log:
        str(OUT_DIR / "match_report.log")
    params:
        out_dir=str(OUT_DIR),
        title="PlanetScope match report"
    script:
        "scripts/_4_match_report.py"


rule _4_match_report_all:
    input:
        match_report_fp
