rule _3_concat_chip_summaries:
    input:
        summary_fp_l
    output:
        concat_summary_fp
    log:
        str(OUT_DIR / "summary_all.log")
    run:
        summary_df = pd.concat([pd.read_csv(fp) for fp in input], ignore_index=True)
        summary_df.to_csv(output[0], index=False)

        event_count_s = summary_df.groupby("event").size().sort_values(ascending=False)
        matched_count_s = summary_df.groupby("event")["matched"].sum(min_count=1).sort_values(ascending=False)
        attempted_count_s = summary_df.groupby("event")["attempted_candidates"].sum(min_count=1).sort_values(ascending=False)

        with open(log[0], "w") as f:
            f.write(f"wrote combined summary to {output[0]}\n")
            f.write(f"rows={len(summary_df):,}\n")
            f.write("event_row_counts:\n")
            f.write(event_count_s.to_string())
            f.write("\n\nevent_matched_counts:\n")
            f.write(matched_count_s.to_string())
            f.write("\n\nevent_attempted_counts:\n")
            f.write(attempted_count_s.to_string())
            f.write("\n")

        logger.info(f"wrote combined summary to {output[0]}")
        logger.info(f"event row counts:\n{event_count_s.to_string()}")
        logger.info(f"event matched counts:\n{matched_count_s.to_string()}")
        logger.info(f"event attempted counts:\n{attempted_count_s.to_string()}")


rule _3_concat_chip_summaries_all:
    input:
        concat_summary_fp


