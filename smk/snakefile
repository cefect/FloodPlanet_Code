from pathlib import Path
import tempfile

import geopandas as gpd
import pandas as pd
from snakemake.logging import logger


SNAKEFILE_DIR = Path(workflow.basedir)
configfile: str(SNAKEFILE_DIR / "config.yaml")


def _parse_id_values(value):
    if value is None:
        return []
    if isinstance(value, str):
        return [v.strip() for v in value.split(",") if v.strip()]
    value_l = []
    for item in value:
        value_l.extend(_parse_id_values(item))
    return value_l


def _parse_bool(value):
    if isinstance(value, bool):
        return value
    return str(value).strip().lower() in {"1", "true", "yes", "y"}


INDEX_FP = Path(config["index_fp"])
OUT_DIR = Path(config["out_dir"])
TMPDIR = Path(tempfile.gettempdir())
CHIP_ID_L = _parse_id_values(config.get("chip_ids", []))
EVENT_ID_L = _parse_id_values(config.get("event_ids", []))
logger.info(f"loading chip index from {INDEX_FP}")
logger.info(f"writing outputs under {OUT_DIR}")
logger.info(f"using system tmpdir {TMPDIR}")
if EVENT_ID_L:
    logger.info(f"event_ids filter: {','.join(EVENT_ID_L)}")
if CHIP_ID_L:
    logger.info(f"chip_ids filter: {','.join(CHIP_ID_L)}")

index_gdf = gpd.read_file(INDEX_FP)[["Event", "Chip_ID"]].drop_duplicates().copy()
if EVENT_ID_L:
    index_gdf = index_gdf.loc[index_gdf["Event"].isin(EVENT_ID_L)].copy()
if CHIP_ID_L:
    index_gdf = index_gdf.loc[index_gdf["Chip_ID"].isin(CHIP_ID_L)].copy()
assert not index_gdf.empty, "No chips selected from the snakemake config"
logger.info(f"selected {len(index_gdf):,} chip(s) for this run")

target_d = index_gdf.sort_values(["Event", "Chip_ID"]).to_dict("list")
order_manifest_fp_l = expand(
    str(OUT_DIR / "{event}" / "{chip_id}" / "chip_order_manifest.json"),
    zip,
    event=target_d["Event"],
    chip_id=target_d["Chip_ID"],
)
search_summary_fp_l = expand(
    str(OUT_DIR / "{event}" / "{chip_id}" / "chip_search_summary.tsv"),
    zip,
    event=target_d["Event"],
    chip_id=target_d["Chip_ID"],
)
summary_fp_l = expand(
    str(OUT_DIR / "{event}" / "{chip_id}" / "summary.csv"),
    zip,
    event=target_d["Event"],
    chip_id=target_d["Chip_ID"],
)
concat_summary_fp = str(OUT_DIR / "summary_all.csv")


rule all:
    input:
        concat_summary_fp
    default_target: True

rule fetch_ps_chip_manifest_all:
    input:
        order_manifest_fp_l,
        search_summary_fp_l

rule fetch_ps_chip_manifest:
    output:
        order_manifest_fp=str(OUT_DIR / "{event}" / "{chip_id}" / "chip_order_manifest.json"),
        search_summary_fp=str(OUT_DIR / "{event}" / "{chip_id}" / "chip_search_summary.tsv")
    log:
        str(OUT_DIR / "{event}" / "{chip_id}" / "fetch_ps_chip_manifest.log")
    params:
        index_fp=str(INDEX_FP),
        out_dir=str(OUT_DIR),
        tmpdir=str(TMPDIR),
        search_limit=int(config["search_limit"]),
        lower_window_hours=int(config["lower_window_hours"]),
        upper_window_hours=int(config["upper_window_hours"]),
        poll_delay_seconds=int(config["poll_delay_seconds"]),
        poll_max_attempts=int(config["poll_max_attempts"]),
        logging_level="DEBUG",
        overwrite=_parse_bool(config.get("overwrite", False))
    script:
        "scripts/fetch_ps_chip_manifest.py"


rule fetch_ps_chip_order:
    input:
        order_manifest_fp=str(OUT_DIR / "{event}" / "{chip_id}" / "chip_order_manifest.json")
    output:
        summary_fp=str(OUT_DIR / "{event}" / "{chip_id}" / "summary.csv")
    log:
        str(OUT_DIR / "{event}" / "{chip_id}" / "fetch_ps_chip_order.log")
    params:
        index_fp=str(INDEX_FP),
        out_dir=str(OUT_DIR),
        tmpdir=str(TMPDIR),
        search_limit=int(config["search_limit"]),
        lower_window_hours=int(config["lower_window_hours"]),
        upper_window_hours=int(config["upper_window_hours"]),
        poll_delay_seconds=int(config["poll_delay_seconds"]),
        poll_max_attempts=int(config["poll_max_attempts"]),
        logging_level="DEBUG",
        overwrite=_parse_bool(config.get("overwrite", False))
    script:
        "scripts/fetch_ps_chip_order.py"


rule concat_chip_summaries:
    input:
        summary_fp_l
    output:
        concat_summary_fp
    log:
        str(OUT_DIR / "summary_all.log")
    run:
        summary_df = pd.concat([pd.read_csv(fp) for fp in input], ignore_index=True)
        summary_df.to_csv(output[0], index=False)

        # Log a short grouped count summary for the combined chip table.
        event_count_s = summary_df.groupby("event").size().sort_values(ascending=False)
        eligible_count_s = summary_df.groupby("event")["eligible"].sum(min_count=1).sort_values(ascending=False)
        downloaded_count_s = summary_df.groupby("event")["downloaded"].sum(min_count=1).sort_values(ascending=False)

        with open(log[0], "w") as f:
            f.write(f"wrote combined summary to {output[0]}\n")
            f.write(f"rows={len(summary_df):,}\n")
            f.write("event_row_counts:\n")
            f.write(event_count_s.to_string())
            f.write("\n\nevent_eligible_counts:\n")
            f.write(eligible_count_s.to_string())
            f.write("\n\nevent_downloaded_counts:\n")
            f.write(downloaded_count_s.to_string())
            f.write("\n")

        logger.info(f"wrote combined summary to {output[0]}")
        logger.info(f"event row counts:\n{event_count_s.to_string()}")
        logger.info(f"event eligible counts:\n{eligible_count_s.to_string()}")
        logger.info(f"event downloaded counts:\n{downloaded_count_s.to_string()}")
