{
  "name": "floodplanet_devcontainer",
  "dockerComposeFile": "./docker-compose.yml",
  "service": "dev",
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  // config codex (mount settings and env var)
  //"updateRemoteUserUID": true,
  //"overrideCommand": false,
  //"remoteUser": "cefect",

  "containerEnv": {
    "CODEX_HOME": "/home/cefect/.codex",
    "CLOUDSDK_CONFIG": "/home/cefect/.config/gcloud",
    "GOOGLE_APPLICATION_CREDENTIALS": "/home/cefect/.config/gcloud/application_default_credentials.json"
  },
  "remoteEnv": {
    "PATH": "/opt/conda/bin:${containerEnv:PATH}",
    "CONDA_PREFIX": "/opt/conda",
    "CONDA_DEFAULT_ENV": "base"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "github.copilot",
        "github.copilot-chat",
        "openai.chatgpt",  
        // "ms-azuretools.vscode-containers",
        // "ms-azuretools.vscode-docker",
        "ms-python.debugpy",
        "ms-python.python",
        "ms-python.vscode-pylance",
        //"ms-python.vscode-python-envs",
        "ms-toolsai.jupyter",
        //"ms-toolsai.datawrangler",
        "ms-toolsai.vscode-jupyter-powertoys",
        "vict0rsch.coblock",
        //"hbenl.vscode-test-explorer",
        //"littlefoxteam.vscode-python-test-adapter",
        //"htcondor.htcondor",
        "snakemake.snakemake-lang",
        "mechatroner.rainbow-csv",
        "google.geminicodeassist",
        "george-alisson.html-preview-vscode", // for viewing html output of notebooks
      ],
      "settings": {
        "python.condaPath": "/opt/conda/bin/conda",
        "python.defaultInterpreterPath": "/opt/conda/bin/python",
        "python.terminal.activateEnvironment": false, // handled by the container
        "python.useEnvironmentsExtension": false, // configure python manually
        "python.testing.pytestEnabled": true, // also set globally
        "python.testing.cwd": "${workspaceFolder}",
        "remote.extensionKind": {
          // "ms-azuretools.vscode-containers": ["ui"],
          // "ms-azuretools.vscode-docker": ["ui"],
          "google.geminicodeassist": ["ui"]
        }
      }
    }
  }
}
